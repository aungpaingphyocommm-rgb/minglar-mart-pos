{
  "entities": {
    "Branch": {
      "title": "Branch",
      "description": "Store branch location with isolated inventory and branch-specific receipt metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "maxLength": 32
        },
        "nameMm": {
          "type": "string",
          "maxLength": 120
        },
        "nameEn": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "addressMm": {
          "type": "string",
          "maxLength": 300
        },
        "addressEn": {
          "type": "string",
          "maxLength": 300
        },
        "isMain": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shopId",
        "code",
        "nameMm",
        "nameEn",
        "phone",
        "addressMm",
        "addressEn",
        "isMain",
        "createdAt",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Mini mart SKU scoped by shared shopId and branchId, synced in real time across devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branchId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "maxLength": 64
        },
        "nameMm": {
          "type": "string",
          "maxLength": 160
        },
        "nameEn": {
          "type": "string",
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": [
            "beverages",
            "snacks",
            "groceries",
            "personal_care",
            "household",
            "dairy_chilled"
          ]
        },
        "costPrice": {
          "type": "number"
        },
        "sellPrice": {
          "type": "number"
        },
        "stock": {
          "type": "number"
        },
        "branchStocks": {
          "type": "object",
          "description": "Map of branchId to numeric stock quantity"
        },
        "minStock": {
          "type": "number"
        },
        "unitMm": {
          "type": "string",
          "maxLength": 32
        },
        "unitEn": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shopId",
        "branchId",
        "sku",
        "nameMm",
        "nameEn",
        "category",
        "costPrice",
        "sellPrice",
        "stock",
        "minStock",
        "unitMm",
        "unitEn",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "POS sale invoice or partial reversal credit note scoped by shopId and branchId.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNo": {
          "type": "string",
          "maxLength": 64
        },
        "branchId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branchNameMm": {
          "type": "string",
          "maxLength": 120
        },
        "branchNameEn": {
          "type": "string",
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "description": "Bounded list of sold or returned line items (max 100 items)"
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "profit": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "kbzpay", "wavepay", "aya_pay"]
        },
        "amountPaid": {
          "type": "number"
        },
        "changeGiven": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "voided"]
        },
        "synced": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "reversalReason": {
          "type": "string",
          "maxLength": 300
        },
        "reversedAt": {
          "type": "string",
          "maxLength": 64
        },
        "reversedItems": {
          "type": "object"
        },
        "reversalOfInvoiceNo": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shopId",
        "invoiceNo",
        "branchId",
        "items",
        "subtotal",
        "discount",
        "total",
        "profit",
        "paymentMethod",
        "amountPaid",
        "changeGiven",
        "status",
        "synced",
        "createdAt",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable inventory audit trail ledger entry scoped by shopId and branchId.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "sku": {
          "type": "string",
          "maxLength": 64
        },
        "productNameMm": {
          "type": "string",
          "maxLength": 160
        },
        "productNameEn": {
          "type": "string",
          "maxLength": 160
        },
        "branchId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branchNameMm": {
          "type": "string",
          "maxLength": 120
        },
        "branchNameEn": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": [
            "sale",
            "restock",
            "adjustment",
            "void",
            "initial",
            "transfer_in",
            "transfer_out"
          ]
        },
        "delta": {
          "type": "number"
        },
        "previousStock": {
          "type": "number"
        },
        "newStock": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        },
        "synced": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shopId",
        "productId",
        "sku",
        "productNameMm",
        "productNameEn",
        "branchId",
        "type",
        "delta",
        "previousStock",
        "newStock",
        "reason",
        "synced",
        "createdAt",
        "serverCreatedAt"
      ]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store profile, shopId, default language, theme preference, and multi-branch toggle.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeNameMm": {
          "type": "string",
          "maxLength": 120
        },
        "storeNameEn": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "addressMm": {
          "type": "string",
          "maxLength": 300
        },
        "addressEn": {
          "type": "string",
          "maxLength": 300
        },
        "receiptFooterMm": {
          "type": "string",
          "maxLength": 200
        },
        "receiptFooterEn": {
          "type": "string",
          "maxLength": 200
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["mm", "en"]
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "activeBranchId": {
          "type": "string",
          "maxLength": 128
        },
        "multiBranchEnabled": {
          "type": "boolean"
        },
        "lastSyncedAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shopId",
        "storeNameMm",
        "storeNameEn",
        "phone",
        "addressMm",
        "addressEn",
        "receiptFooterMm",
        "receiptFooterEn",
        "defaultLanguage",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    }
  },
  "firestore": {
    "/branches/{branchId}": {
      "schema": {
        "$ref": "#/entities/Branch"
      },
      "description": "Store branches synced in real time across all devices in the same shopId."
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Mini mart product catalog scoped by shopId and branchId, synced in real time across devices."
    },
    "/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Completed POS sales, voided invoices, and partial reversal credit notes scoped by shopId and branchId."
    },
    "/movements/{movementId}": {
      "schema": {
        "$ref": "#/entities/StockMovement"
      },
      "description": "Stock audit movements scoped by shopId and branchId."
    },
    "/settings/{settingsId}": {
      "schema": {
        "$ref": "#/entities/StoreSettings"
      },
      "description": "Store configuration and shopId settings shared across devices."
    }
  }
}
