rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && isValidId(request.auth.uid);
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'aungpaingphyo.com.mm@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Anonymous Auth is used strictly for authentication; shop isolation uses shared shopId
    function isShopAccess(data) {
      return isSignedIn() && (data.shopId == 'mingalar-mart-pos-main' || isValidId(data.shopId));
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // Entity Validation Blueprints
    function isValidBranch(data, docId) {
      return isValidId(docId)
      && data.keys().hasAll([
        'id', 'shopId', 'code', 'nameMm', 'nameEn',
        'phone', 'addressMm', 'addressEn', 'isMain',
        'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'shopId', 'code', 'nameMm', 'nameEn',
        'phone', 'addressMm', 'addressEn', 'isMain',
        'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.shopId)
      && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
      && data.nameMm is string && data.nameMm.size() >= 1 && data.nameMm.size() <= 120
      && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
      && data.phone is string && data.phone.size() <= 40
      && data.addressMm is string && data.addressMm.size() <= 300
      && data.addressEn is string && data.addressEn.size() <= 300
      && data.isMain is bool
      && data.createdAt is string && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() <= 64
      && data.serverCreatedAt is timestamp
      && data.serverUpdatedAt is timestamp;
    }

    function isValidProduct(data, docId) {
      return isValidId(docId)
      && data.keys().hasAll([
        'id', 'shopId', 'branchId', 'sku', 'nameMm', 'nameEn', 'category',
        'costPrice', 'sellPrice', 'stock', 'minStock',
        'unitMm', 'unitEn', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'shopId', 'branchId', 'sku', 'nameMm', 'nameEn', 'category',
        'costPrice', 'sellPrice', 'stock', 'branchStocks', 'minStock',
        'unitMm', 'unitEn', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.shopId)
      && isValidId(data.branchId)
      && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
      && data.nameMm is string && data.nameMm.size() >= 1 && data.nameMm.size() <= 160
      && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 160
      && data.category in ['beverages', 'snacks', 'groceries', 'personal_care', 'household', 'dairy_chilled']
      && data.costPrice is number && data.costPrice >= 0
      && data.sellPrice is number && data.sellPrice >= 0
      && data.stock is number && data.stock >= 0
      && (!('branchStocks' in data) || (data.branchStocks is map && data.branchStocks.size() <= 50))
      && data.minStock is number && data.minStock >= 0
      && data.unitMm is string && data.unitMm.size() >= 1 && data.unitMm.size() <= 32
      && data.unitEn is string && data.unitEn.size() >= 1 && data.unitEn.size() <= 32
      && data.updatedAt is string && data.updatedAt.size() <= 64
      && data.serverCreatedAt is timestamp
      && data.serverUpdatedAt is timestamp;
    }

    function isValidSale(data, docId) {
      return isValidId(docId)
      && data.keys().hasAll([
        'id', 'shopId', 'invoiceNo', 'branchId', 'items',
        'subtotal', 'discount', 'total', 'profit',
        'paymentMethod', 'amountPaid', 'changeGiven',
        'status', 'synced', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'shopId', 'invoiceNo', 'branchId', 'branchNameMm', 'branchNameEn',
        'items', 'subtotal', 'discount', 'total', 'profit',
        'paymentMethod', 'amountPaid', 'changeGiven',
        'status', 'synced', 'note', 'reversalReason', 'reversedAt',
        'reversedItems', 'reversalOfInvoiceNo',
        'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.shopId)
      && data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 64
      && isValidId(data.branchId)
      && isOptionalString(data, 'branchNameMm', 120)
      && isOptionalString(data, 'branchNameEn', 120)
      && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
      && data.items[0] is map
      && data.items[0].keys().hasAll(['productId', 'sku', 'nameMm', 'nameEn', 'qty', 'unitPrice', 'costPrice', 'subtotal'])
      && data.items[0].productId is string && data.items[0].productId.size() <= 128
      && data.subtotal is number
      && data.discount is number
      && data.total is number
      && data.profit is number
      && data.paymentMethod in ['cash', 'kbzpay', 'wavepay', 'aya_pay']
      && data.amountPaid is number
      && data.changeGiven is number && data.changeGiven >= 0
      && data.status in ['completed', 'voided']
      && data.synced is bool
      && isOptionalString(data, 'note', 300)
      && isOptionalString(data, 'reversalReason', 300)
      && isOptionalString(data, 'reversedAt', 64)
      && (!('reversedItems' in data) || (data.reversedItems is map && data.reversedItems.size() <= 100))
      && isOptionalString(data, 'reversalOfInvoiceNo', 64)
      && data.createdAt is string && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() <= 64
      && data.serverCreatedAt is timestamp
      && data.serverUpdatedAt is timestamp;
    }

    function isValidMovement(data, docId) {
      return isValidId(docId)
      && data.keys().hasAll([
        'id', 'shopId', 'productId', 'sku', 'productNameMm', 'productNameEn', 'branchId',
        'type', 'delta', 'previousStock', 'newStock', 'reason', 'synced',
        'createdAt', 'serverCreatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'shopId', 'productId', 'sku', 'productNameMm', 'productNameEn',
        'branchId', 'branchNameMm', 'branchNameEn',
        'type', 'delta', 'previousStock', 'newStock', 'reason', 'synced',
        'createdAt', 'updatedAt', 'serverCreatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.shopId)
      && isValidId(data.productId)
      && isValidId(data.branchId)
      && data.sku is string && data.sku.size() <= 64
      && data.productNameMm is string && data.productNameMm.size() <= 160
      && data.productNameEn is string && data.productNameEn.size() <= 160
      && isOptionalString(data, 'branchNameMm', 120)
      && isOptionalString(data, 'branchNameEn', 120)
      && data.type in ['sale', 'restock', 'adjustment', 'void', 'initial', 'transfer_in', 'transfer_out']
      && data.delta is number
      && data.previousStock is number && data.previousStock >= 0
      && data.newStock is number && data.newStock >= 0
      && data.reason is string && data.reason.size() <= 300
      && data.synced is bool
      && data.createdAt is string && data.createdAt.size() <= 64
      && isOptionalString(data, 'updatedAt', 64)
      && data.serverCreatedAt is timestamp;
    }

    function isValidSettings(data, docId) {
      return isValidId(docId)
      && data.keys().hasAll([
        'id', 'shopId', 'storeNameMm', 'storeNameEn', 'phone',
        'addressMm', 'addressEn', 'receiptFooterMm', 'receiptFooterEn',
        'defaultLanguage', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'shopId', 'storeNameMm', 'storeNameEn', 'phone',
        'addressMm', 'addressEn', 'receiptFooterMm', 'receiptFooterEn',
        'defaultLanguage', 'theme', 'activeBranchId', 'multiBranchEnabled', 'lastSyncedAt',
        'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
      ])
      && data.id is string && data.id.size() <= 128
      && isValidId(data.shopId)
      && data.storeNameMm is string && data.storeNameMm.size() <= 120
      && data.storeNameEn is string && data.storeNameEn.size() <= 120
      && data.phone is string && data.phone.size() <= 40
      && data.addressMm is string && data.addressMm.size() <= 300
      && data.addressEn is string && data.addressEn.size() <= 300
      && data.receiptFooterMm is string && data.receiptFooterMm.size() <= 200
      && data.receiptFooterEn is string && data.receiptFooterEn.size() <= 200
      && data.defaultLanguage in ['mm', 'en']
      && (!('theme' in data) || data.theme in ['light', 'dark'])
      && isOptionalString(data, 'activeBranchId', 128)
      && (!('multiBranchEnabled' in data) || data.multiBranchEnabled is bool)
      && (!('lastSyncedAt' in data) || data.lastSyncedAt == null || (data.lastSyncedAt is string && data.lastSyncedAt.size() <= 64))
      && data.updatedAt is string && data.updatedAt.size() <= 64
      && data.serverCreatedAt is timestamp
      && data.serverUpdatedAt is timestamp;
    }

    // Admins Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.token.email_verified == true && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Branches Collection (Shared Shop Real-Time Sync across devices)
    match /branches/{branchId} {
      allow get: if isValidId(branchId) && (isShopAccess(existing()) || isAdmin());
      allow list: if isShopAccess(existing()) || isBootstrappedAdmin();
      allow create: if isSignedIn()
        && isValidId(branchId)
        && isValidBranch(incoming(), branchId)
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(branchId)
        && isValidBranch(incoming(), branchId)
        && incoming().shopId == existing().shopId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && (
          isAdmin()
          || (
            isShopAccess(existing())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'nameMm', 'nameEn', 'phone', 'addressMm', 'addressEn', 'isMain', 'updatedAt', 'serverUpdatedAt'
            ])
          )
        );
      allow delete: if isValidId(branchId) && (isShopAccess(existing()) || isAdmin()) && existing().isMain == false;
    }

    // Products Collection (Shared Shop + Branch Real-Time Sync)
    match /products/{productId} {
      allow get: if isValidId(productId) && (isShopAccess(existing()) || isAdmin());
      allow list: if isShopAccess(existing()) || isBootstrappedAdmin();
      allow create: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().shopId == existing().shopId
        && incoming().branchId == existing().branchId
        && incoming().id == existing().id
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && (
          isAdmin()
          || (
            isShopAccess(existing()) && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'sku', 'nameMm', 'nameEn', 'category', 'costPrice', 'sellPrice',
                'stock', 'branchStocks', 'minStock', 'unitMm', 'unitEn', 'updatedAt', 'serverUpdatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly([
                'stock', 'branchStocks', 'updatedAt', 'serverUpdatedAt'
              ])
            )
          )
        );
      allow delete: if isValidId(productId) && (isShopAccess(existing()) || isAdmin());
    }

    // Sales Collection (Shared Shop + Branch Real-Time Sync + Terminal State Locking)
    match /sales/{saleId} {
      allow get: if isValidId(saleId) && (isShopAccess(existing()) || isAdmin());
      allow list: if isShopAccess(existing()) || isBootstrappedAdmin();
      allow create: if isSignedIn()
        && isValidId(saleId)
        && isValidSale(incoming(), saleId)
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(saleId)
        && isValidSale(incoming(), saleId)
        && incoming().shopId == existing().shopId
        && incoming().id == existing().id
        && incoming().branchId == existing().branchId
        && incoming().invoiceNo == existing().invoiceNo
        && incoming().createdAt == existing().createdAt
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && (
          isAdmin()
          || (
            isShopAccess(existing())
            && existing().status != 'voided'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'reversedItems', 'reversalReason', 'reversedAt', 'synced', 'updatedAt', 'serverUpdatedAt'
              ])
              || incoming().diff(existing()).affectedKeys().hasOnly(['synced', 'updatedAt', 'serverUpdatedAt'])
            )
          )
        );
      allow delete: if isValidId(saleId) && (isShopAccess(existing()) || isAdmin());
    }

    // Stock Movements Collection (Shared Shop + Branch Audit Ledger)
    match /movements/{movementId} {
      allow get: if isValidId(movementId) && (isShopAccess(existing()) || isAdmin());
      allow list: if isShopAccess(existing()) || isBootstrappedAdmin();
      allow create: if isSignedIn()
        && isValidId(movementId)
        && isValidMovement(incoming(), movementId)
        && incoming().serverCreatedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(movementId) && (isShopAccess(existing()) || isAdmin());
    }

    // Store Settings Collection (Shared Shop Settings)
    match /settings/{settingsId} {
      allow get: if isValidId(settingsId) && (isShopAccess(existing()) || isAdmin());
      allow list: if isShopAccess(existing()) || isBootstrappedAdmin();
      allow create: if isSignedIn()
        && isValidId(settingsId)
        && isValidSettings(incoming(), settingsId)
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(settingsId)
        && isValidSettings(incoming(), settingsId)
        && incoming().shopId == existing().shopId
        && incoming().id == existing().id
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && (
          isAdmin()
          || (
            isShopAccess(existing())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'storeNameMm', 'storeNameEn', 'phone', 'addressMm', 'addressEn',
              'receiptFooterMm', 'receiptFooterEn', 'defaultLanguage', 'theme',
              'activeBranchId', 'multiBranchEnabled', 'lastSyncedAt', 'updatedAt', 'serverUpdatedAt'
            ])
          )
        );
      allow delete: if isValidId(settingsId) && (isShopAccess(existing()) || isAdmin());
    }
  }
}
